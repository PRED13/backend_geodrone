PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL (usa los mismos valores del docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geodrone_db
DB_USER=postgres
DB_PASSWORD=geodrone1234
# Optional CA certificate for managed PostgreSQL providers such as Aiven.
DB_SSL_CA=

# JWT
JWT_SECRET=geodrone_super_secret_key_2024
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_PATH=uploads
